# Copy to .env and adjust as needed. All variables use the BCD_ prefix.

BCD_ENVIRONMENT=development
BCD_MAX_UPLOAD_MB=10
BCD_INPUT_VALIDATION=true
BCD_GENERATE_GRADCAM=true
BCD_TORCH_THREADS=4
BCD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional overrides (absolute paths recommended for production)
# BCD_MODEL_PATH=models/vgg19_breakhis.pt
# BCD_METRICS_PATH=models/metrics.json
# BCD_REFERENCE_STATS_PATH=models/reference_stats.npz
# BCD_DATABASE_URL=sqlite:///storage/app.db
